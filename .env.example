# ──────────────────────────────────────────────────────────────
# Gravity Claw — Environment Template
# Copy this to .env and fill in your real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# Telegram Bot API token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API key (from openrouter.ai/keys)
MODEL_API_KEY=your_openrouter_api_key_here

# Your personal Telegram user ID (get it from @userinfobot)
# The bot will silently ignore anyone not on this list.
# Comma-separated for multiple IDs, e.g.: 123456789,987654321
TELEGRAM_ALLOWLIST_USER_ID=your_telegram_user_id_here

# Supabase Configuration (Level 2: Memory)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: model to use via OpenRouter (default: anthropic/claude-3.5-haiku)
# Any model slug from openrouter.ai/models works here, e.g.:
# CLAUDE_MODEL=openai/gpt-4o-mini
# CLAUDE_MODEL=google/gemini-flash-1.5
# CLAUDE_MODEL=anthropic/claude-3.5-sonnet
# CLAUDE_MODEL=anthropic/claude-3.5-haiku

# ── Gmail Integration (optional) ───────────────────────────────────────────
# Scope required: https://www.googleapis.com/auth/gmail.readonly
# Leave blank to disable Gmail tool.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
